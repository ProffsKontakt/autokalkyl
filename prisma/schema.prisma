// Kvittera – digital kvittohantering
// Prisma schema. Run `npx prisma migrate deploy` (see prisma/migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum AccountType {
  PRIVATE // Privatperson
  BUSINESS // Företag (waitlist only for now)
}

enum ReceiptStatus {
  PROCESSING // Uploaded, AI extraction in progress
  READY // Extracted and stored
  NEEDS_REVIEW // Stored but extraction was incomplete/failed – user should verify fields
  FAILED // Could not be processed at all
}

enum ReceiptSource {
  SCAN // Camera capture in the app
  UPLOAD // Picked from photo library / files
  EMAIL // Forwarded to the user's unique inbound address
  MANUAL // Entered by hand
}

enum FileKind {
  IMAGE
  PDF
  EMAIL_HTML
  EMAIL_TEXT
}

enum MessageRole {
  USER
  ASSISTANT
}

enum InboundStatus {
  ACCEPTED
  REJECTED
  FAILED
}

// =============================================================================
// USER & AUTH
// =============================================================================

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  accountType  AccountType @default(PRIVATE)
  // Unique local-part for the user's inbound receipt address, e.g. kvitto-a1b2c3d4@in.kvittera.se
  inboundToken String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  receipts            Receipt[]
  conversations       Conversation[]
  auditEvents         AuditEvent[]
  passwordResetTokens PasswordResetToken[]
  inboundEmails       InboundEmail[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// RECEIPTS
// =============================================================================

model Receipt {
  id     String        @id @default(cuid())
  userId String
  status ReceiptStatus @default(PROCESSING)
  source ReceiptSource

  // Extracted / editable fields
  title             String? // Short display title, e.g. "Elgiganten – Samsung TV"
  merchantName      String?
  merchantOrgNumber String?
  merchantAddress   String?
  purchaseDate      DateTime? @db.Date
  totalAmount       Decimal?  @db.Decimal(12, 2)
  vatAmount         Decimal?  @db.Decimal(12, 2)
  currency          String    @default("SEK")
  category          String?
  paymentMethod     String?
  receiptNumber     String?
  notes             String?
  tags              String[]  @default([])

  // AI output
  ocrText         String?
  aiSummary       String?
  aiConfidence    Float?
  processingError String?

  // Warranty / consumer rights
  warrantyMonths    Int?
  warrantyExpiresAt DateTime? @db.Date
  warrantyNotes     String?
  returnDeadline    DateTime? @db.Date // Öppet köp / ångerrätt

  // Email metadata when source = EMAIL
  emailFrom    String?
  emailSubject String?

  // Retention (bokföringslagen: 7 år) and soft delete
  retentionUntil DateTime? @db.Date
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ReceiptItem[]
  files         ReceiptFile[]
  conversations Conversation[]
  auditEvents   AuditEvent[]
  inboundEmails InboundEmail[]

  @@index([userId, deletedAt, purchaseDate])
  @@index([userId, createdAt])
  @@index([userId, warrantyExpiresAt])
  @@index([userId, merchantName])
}

model ReceiptItem {
  id        String @id @default(cuid())
  receiptId String
  position  Int    @default(0)

  name          String
  quantity      Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice     Decimal? @db.Decimal(12, 2)
  totalPrice    Decimal? @db.Decimal(12, 2)
  articleNumber String?
  brand         String?
  model         String?
  serialNumber  String?
  productUrl    String?
  manualUrl     String?
  warrantyMonths Int?
  category      String?

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model ReceiptFile {
  id           String   @id @default(cuid())
  receiptId    String
  kind         FileKind
  mimeType     String
  byteSize     Int
  sha256       String
  data         Bytes
  thumbnail    Bytes?
  width        Int?
  height       Int?
  originalName String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

// =============================================================================
// AUDIT LOG (spårbarhet)
// =============================================================================

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  receiptId String?
  action    String // e.g. receipt.created, receipt.updated, receipt.viewed, receipt.deleted, export.csv, auth.login
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([receiptId, createdAt])
}

// =============================================================================
// AI ASSISTANT
// =============================================================================

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  receiptId String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt  Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([receiptId])
}

model ChatMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  text           String // Plain text for display
  content        Json // Full API content blocks for replay (tool use, citations)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// =============================================================================
// BUSINESS WAITLIST & INBOUND EMAIL LOG
// =============================================================================

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  message   String?
  createdAt DateTime @default(now())
}

model InboundEmail {
  id          String        @id @default(cuid())
  userId      String?
  receiptId   String?
  toAddress   String
  fromAddress String
  subject     String?
  status      InboundStatus
  error       String?
  createdAt   DateTime      @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
