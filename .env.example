# Kvittera – miljövariabler
# Kopiera till .env.local och fyll i värdena. Samma variabler sätts i Vercel → Project → Settings → Environment Variables.

# =============================================================================
# DATABAS (Neon PostgreSQL) – KRÄVS
# =============================================================================
# Använd "pooled" connection string från Neon Console.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# =============================================================================
# AUTENTISERING (Auth.js v5) – KRÄVS
# =============================================================================
# Generera med: openssl rand -base64 32
AUTH_SECRET="byt-ut-mig"
# Sätts automatiskt på Vercel. Lokalt: http://localhost:3001
AUTH_URL="http://localhost:3001"

# =============================================================================
# APP / VARUMÄRKE
# =============================================================================
# Publik URL (används i mail, delningslänkar, sitemap)
NEXT_PUBLIC_APP_URL="https://kvittera.se"
# Varumärkesnamn – siten är byggd för att byta domän utan kodändring
NEXT_PUBLIC_BRAND_NAME="Kvittera"

# =============================================================================
# AI (Anthropic) – KRÄVS för OCR-tolkning och assistenten
# =============================================================================
ANTHROPIC_API_KEY="sk-ant-..."
# Valfritt: modell för tolkning/assistent (standard: claude-opus-5)
# ANTHROPIC_MODEL="claude-opus-5"

# =============================================================================
# INKOMMANDE KVITTON VIA E-POST
# =============================================================================
# Domänen som varje användares unika adress ligger på, t.ex. kvitto-ab12cd34@in.kvittera.se
INBOUND_EMAIL_DOMAIN="in.kvittera.se"
# Delad hemlighet som din e-postleverantör (Postmark/Mailgun/SendGrid/Cloudflare Email Worker/n8n)
# skickar med som header "x-inbound-secret" eller query "?secret=" till POST /api/inbound/email
INBOUND_EMAIL_SECRET="byt-ut-mig"

# =============================================================================
# UTGÅENDE E-POST (lösenordsåterställning, välkomstmail) – valfritt
# =============================================================================
# Alternativ 1: Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Kvittera <noreply@kvittera.se>"
# Alternativ 2: n8n-webhook som tar emot { to, subject, html, text }
N8N_EMAIL_WEBHOOK_URL=""
# Om ingen av ovan är satt loggas mailen till konsolen (endast utveckling).
